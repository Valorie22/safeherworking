# SafeHer — copy to .env and fill in.
#
# Local stack:  supabase start   then   supabase status
# Hosted:       Supabase dashboard -> Project Settings -> API
#
# The anon key is a PUBLIC key. It is safe in a client bundle because
# Row Level Security is what actually guards the data (0003_rls.sql).
# The service_role key is NOT used anywhere in this project, by design.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=

# The web control rooms read the VITE_ prefixed copies.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# The Expo apps read the EXPO_PUBLIC_ prefixed copies. On a phone these
# must be your machine's LAN address, not 127.0.0.1 — the phone cannot
# reach your laptop's loopback.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.10:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
